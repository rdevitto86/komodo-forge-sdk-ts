{
  "name": "@komodo-forge-sdk/typescript",
  "version": "0.2.0",
  "description": "An internal library for Komodo APIs built using Node",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "keywords": [
    "komodo",
    "forge",
    "sdk",
    "typescript",
    "node",
    "javascript",
    "client",
    "api",
    "shared"
  ],
  "author": "Komodo Future Solutions",
  "license": "ISC",
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "rebuild": "pnpm run clean && pnpm run build",
    "fresh": "rm -rf node_modules && pnpm update --latest && pnpm install",
    "update": "pnpm update --latest && pnpm install",
    "prepublishOnly": "pnpm run rebuild",
    "release": "bash scripts/release.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@eslint/json": "^2.0.0",
    "fast-redact": "^3.5.0",
    "globals": "^17.6.0",
    "jose": "^6.2.3",
    "typescript-eslint": "^8.60.1"
  },
  "peerDependencies": {
    "eslint": ">=9.0.0"
  },
  "devDependencies": {
    "@types/fast-redact": "^3.0.4",
    "@types/node": "^25.9.2",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^10.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./api": {
      "types": "./dist/api/index.d.ts",
      "import": "./dist/api/index.js"
    },
    "./api/*": {
      "types": "./dist/api/*/index.d.ts",
      "import": "./dist/api/*/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./client/*": {
      "types": "./dist/client/*/index.d.ts",
      "import": "./dist/client/*/index.js"
    },
    "./shared": {
      "types": "./dist/shared/index.d.ts",
      "import": "./dist/shared/index.js"
    },
    "./shared/*": {
      "types": "./dist/shared/*/index.d.ts",
      "import": "./dist/shared/*/index.js"
    },
    "./eslint": {
      "types": "./dist/shared/eslint/index.d.ts",
      "import": "./dist/shared/eslint/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ]
}
