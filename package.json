{
  "name": "@komodo-forge-sdk/typescript",
  "version": "0.6.1",
  "description": "An internal library for Komodo APIs built using Node",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "keywords": [
    "komodo",
    "forge",
    "sdk",
    "typescript",
    "node",
    "javascript",
    "client",
    "api",
    "shared"
  ],
  "author": "Komodo Future Solutions",
  "license": "ISC",
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "rebuild": "pnpm run clean && pnpm run build",
    "fresh": "rm -rf node_modules && pnpm update --latest && pnpm install",
    "update": "pnpm update --latest && pnpm install",
    "prepublishOnly": "pnpm run rebuild",
    "release": "bash scripts/release.sh",
    "install-hooks": "git config core.hooksPath scripts/hooks && echo \"hooks installed — pre-commit mandatory, pre-push optional\"",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.261.0",
    "constructs": "^10.6.0",
    "fast-redact": "^3.5.0",
    "globals": "^17.7.0",
    "jose": "^6.2.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@types/fast-redact": "^3.0.4",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./api": {
      "types": "./dist/api/index.d.ts",
      "import": "./dist/api/index.js"
    },
    "./api/*": {
      "types": "./dist/api/*/index.d.ts",
      "import": "./dist/api/*/index.js"
    },
    "./aws": {
      "types": "./dist/aws/index.d.ts",
      "import": "./dist/aws/index.js"
    },
    "./aws/*": {
      "types": "./dist/aws/*/index.d.ts",
      "import": "./dist/aws/*/index.js"
    },
    "./http": {
      "types": "./dist/http/index.d.ts",
      "import": "./dist/http/index.js"
    },
    "./http/*": {
      "types": "./dist/http/*/index.d.ts",
      "import": "./dist/http/*/index.js"
    },
    "./logging": {
      "types": "./dist/logging/index.d.ts",
      "import": "./dist/logging/index.js"
    },
    "./logging/*": {
      "types": "./dist/logging/*/index.d.ts",
      "import": "./dist/logging/*/index.js"
    },
    "./redaction": {
      "types": "./dist/redaction/index.d.ts",
      "import": "./dist/redaction/index.js"
    },
    "./security": {
      "types": "./dist/security/index.d.ts",
      "import": "./dist/security/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=26.0.0"
  }
}